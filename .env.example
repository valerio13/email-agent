# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker-compose and by the backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# LLM provider (changing model or vendor only needs these variables)
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=

# Gmail OAuth (only needed for real mailbox mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
DEMO_MODE=true

# Daily run (HH:MM in the given IANA timezone). Use a single API worker, or it runs once per worker.
SCHEDULER_ENABLED=true
SCHEDULE_TIME=07:00
SCHEDULE_TIMEZONE=UTC
