# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker-compose and by the backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# LLM provider (changing model or vendor only needs these variables)
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=

# Gmail OAuth (only needed for real mailbox mode, DEMO_MODE=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed once by: uv run python -m app.cli authorize-gmail
GOOGLE_REFRESH_TOKEN=
# Which mail the real mailbox returns: a Gmail search, and the most emails per run (1 to 500)
GMAIL_QUERY=in:inbox newer_than:2d
GMAIL_MAX_EMAILS=50

# App
DEMO_MODE=true

# Daily run (HH:MM in the given IANA timezone). Use a single API worker, or it runs once per worker.
SCHEDULER_ENABLED=true
SCHEDULE_TIME=07:00
SCHEDULE_TIMEZONE=UTC
